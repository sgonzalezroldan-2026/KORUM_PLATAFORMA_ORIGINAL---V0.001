# =============================================================================
# KORUM · Plantilla de variables de entorno
# Copia este archivo a .env.local (desarrollo) y rellena los valores. Nunca subas .env* al repositorio.
# Lo operativo (Paycomet, email, Veri*factu, Hucha, SEO, textos legales) se configura en /admin/ajustes;
# aquí solo va lo que protege la consola y los datos cifrados, y la infraestructura.
# Detalle: .agents/rules/01-arquitectura-y-codigo.md §5 y docs/DECISIONES_TECNICAS.md §6
# =============================================================================

# --- Base de datos (PostgreSQL) -------------------------------------------------
# Desarrollo: docker compose up -d  →  postgresql://korum:korum@localhost:5432/korum
DATABASE_URL="postgresql://korum:korum@localhost:5432/korum"
# Conexión directa para migraciones (en Supabase, la que no pasa por el pooler)
DIRECT_URL="postgresql://korum:korum@localhost:5432/korum"

# --- Seguridad (generar cada valor con: openssl rand -base64 32) ---------------
BETTER_AUTH_SECRET=""
# Clave AES-256-GCM (32 bytes en base64) para secretos de la consola, tokens de pago y NIF
ENCRYPTION_KEY=""
ENCRYPTION_KEY_VERSION="1"
# Clave para los HMAC de NIF, IP y huellas de dispositivo
DATA_HMAC_SECRET=""
# Clave de firma de los pases QR
QR_HMAC_SECRET=""
# Secreto que deben enviar las llamadas a /api/cron/*
CRON_SECRET=""

# --- Pagos ----------------------------------------------------------------------
# mock = simulador local determinista · sandbox · live
PAYCOMET_MODE="mock"
# Opcionales (respaldo si /admin/ajustes aún no tiene valor; la consola tiene prioridad)
PAYCOMET_API_KEY=""
PAYCOMET_MERCHANT_CODE=""
PAYCOMET_TERMINAL_ID=""
PAYCOMET_WEBHOOK_SECRET=""

# --- Ficheros (Supabase Storage, región UE) -------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Email y facturación (opcionales: respaldo de /admin/ajustes) ---------------
EMAIL_API_KEY=""
VERIFACTU_ISSUER_NIF=""

# --- URL pública, errores y analítica -------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# --- Arranque y demostración ----------------------------------------------------
# Email del primer Super-Admin (recibe la invitación al arrancar si no existe ninguno)
SUPERADMIN_BOOTSTRAP_EMAIL=""
# true solo en el entorno de demostración: activa la barra de entornos y perfiles simulados
NEXT_PUBLIC_DEMO_MODE="false"
