// -----------------------------------------------------------------------------
// Configuración global (Motor de Reglas del Super-Admin)
// -----------------------------------------------------------------------------

model GlobalConfig {
  id                      String      @id @default("GLOBAL")
  exemptLimitCents        Int         @default(100000)
  /// Todo lo de esta tabla se edita desde el motor de reglas del Super-Admin. Si una combinación hace perder dinero
  /// o es incoherente, la consola avisa (docs/DECISIONES_TECNICAS.md §6.1) pero nunca impide guardar.
  bracketMode             BracketMode @default(FLAT)
  /// Límite superior del tramo 1 y del tramo 2, sobre el neto garantizado (500000 = 5.000,00 €).
  t1MaxCents              Int         @default(500000)
  t2MaxCents              Int         @default(1500000)
  t1Bps                   Int         @default(500)
  t2Bps                   Int         @default(400)
  t3Bps                   Int         @default(300)
  sponsorFeeBps           Int         @default(1500)
  /// Importe sugerido de la aportación voluntaria de garantía (el check va DESMARCADO por defecto).
  fullIntegrityCheckCents Int         @default(180)
  guaranteePresetsCents   Int[]       @default([0, 100, 200, 400])
  defaultGuaranteeIdx     Int         @default(2)
  gatewayPctBps           Int         @default(100)
  gatewayFixedCents       Int         @default(9)
  /// Fee de gestión de Mi Hucha por cargo: fijo + porcentaje (fee = topupFeeCents + importe × topupFeeBps / 10000).
  topupFeeCents           Int         @default(25)
  topupFeeBps             Int         @default(0)
  ticketFeeFixedCents     Int         @default(45)
  ticketFeeBps            Int         @default(200)
  maintActive             Boolean     @default(false)
  maintPerInitCents       Int         @default(4900)
  maintAnnualCapCents     Int         @default(14700)
  /// Duración máxima de una campaña. Paycomet exige repartir fondos antes de 90 días desde el cobro.
  maxCampaignDays         Int         @default(60)
  creditPoolMaxDays       Int         @default(60)
  updatedAt               DateTime    @updatedAt
}

model MedalTierConfig {
  key               String   @id
  name              String
  icon              String
  rank              Int      @unique
  campaignsRequired Int
  grantCents        Int
  updatedAt         DateTime @updatedAt
}

model GlobalCategory {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  icon      String           @default("✨")
  rule      CategoryRuleType @default(BRACKETS)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
}

/// Ajustes operativos editables desde la consola del Super-Admin (no secretos).
/// Claves documentadas en docs/DECISIONES_TECNICAS.md §6 (p. ej. "hucha.mode", "autoBoost.publicDisclosureDefault").
model PlatformSetting {
  key         String   @id
  valueJson   Json
  version     Int      @default(1)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Secretos editables desde la consola (credenciales Paycomet, API key de email...). Cifrados con ENCRYPTION_KEY.
model PlatformSecret {
  key         String   @id
  ciphertext  String
  iv          String
  authTag     String
  keyVersion  Int
  hint        String? // Últimos 4 caracteres, para reconocerla sin mostrarla
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Usuarios y autenticación (formato Better Auth + campos KORUM)
// -----------------------------------------------------------------------------

model User {
  id                   String    @id @default(cuid())
  name                 String    @default("")
  email                String    @unique
  /// Email normalizado anti-multicuenta (ver korum-quorum-antifraud).
  canonicalEmail       String    @unique
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  image                String?
  twoFactorEnabled     Boolean   @default(false)
  isSuperadmin         Boolean   @default(false)
  locale               Locale    @default(es)
  /// NIF cifrado (solo si el usuario lo aporta para su certificado fiscal) y su HMAC para búsquedas.
  nifEnc               String?
  nifHmac              String?
  nifKeyVersion        Int?
  provinceCode         String? // Código INE de provincia (2 dígitos), necesario para el Modelo 182
  postalCode           String?
  /// Espejo del saldo de Mi Hucha en el proveedor regulado. La fuente de verdad es el proveedor.
  walletBalanceCents   Int       @default(0)
  walletProvider       String?
  walletExternalId     String?   @unique
  activeOrganizationId String?
  gdprAnonymizedAt     DateTime?
  /// Última actividad de la cuenta (inicio de sesión o aportación). A los 3 años sin actividad se avisa y, 30 días después, se anonimiza.
  lastActiveAt         DateTime  @default(now())
  /// Aviso de inactividad enviado. Si la persona vuelve antes de 30 días, el aviso deja de contar.
  inactivityNoticeAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions              Session[]
  accounts              Account[]
  twoFactors            TwoFactor[]
  passkeys              Passkey[]
  memberships           OrganizationMember[]
  contributions         Contribution[]
  walletTransactions    WalletTransaction[]
  walletSubscriptions   WalletSubscription[]
  doubleCheckSignatures DoubleCheckSignature[]
  paymentMethodTokens   PaymentMethodToken[]
  doubleCheckChallenges DoubleCheckChallenge[]
  deviceAccounts        DeviceAccount[]
  signatureAudits       IdeaSignatureAudit[]
  consentRecords        ConsentRecord[]
  privacyRequests       PrivacyRequest[]
  escrowLedgerEntries   EscrowLedgerEntry[]

  @@index([gdprAnonymizedAt, lastActiveAt])
}

model Session {
  id                     String    @id
  expiresAt              DateTime
  token                  String    @unique
  ipAddress              String?
  userAgent              String?
  userId                 String
  /// Última reautenticación de esta sesión (enlace mágico, código por email, TOTP o llave de acceso). La escribe solo la capa de sesión
  /// (`markSessionReauthenticated`); la exigen exportar o suprimir datos personales (src/core/security/verified-actor.ts).
  reauthenticatedAt      DateTime?
  /// Última vez que esta sesión superó el segundo factor (TOTP o llave de acceso). La exigen los cambios de ajustes del Super-Admin.
  secondFactorVerifiedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  /// Secreto TOTP y códigos de respaldo, cifrados por Better Auth con BETTER_AUTH_SECRET.
  secret                  String
  backupCodes             String
  userId                  String
  /// El secreto solo vale cuando la persona ha introducido un primer código correcto.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Límite de intentos (compatible con el almacenamiento en base de datos de Better Auth).
/// Se reutiliza para PIN de portería, checkout y firmas de ideas.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
}

// -----------------------------------------------------------------------------
// Organizaciones (entidad titular de los fondos)
// -----------------------------------------------------------------------------

model Organization {
  id                       String               @id
  slug                     String               @unique
  /// Nombre público de la comunidad (p. ej. "CEIP Cervantes").
  name                     String
  /// Razón social de la entidad TITULAR de los fondos (p. ej. "AFA CEIP Cervantes").
  legalName                String
  legalForm                LegalForm
  centerOwnership          CenterOwnership      @default(NOT_APPLICABLE)
  vertical                 OrganizationVertical @default(SCHOOL)
  province                 String
  provinceCode             String?
  /// Municipio y código postal que declara la entidad en el alta: el buscador de la portada los usa (ARQUITECTURA_LANDING §1.1).
  city                     String?
  postalCode               String?
  contactEmail             String?
  contactPhone             String?
  cif                      String?              @unique
  iban                     String?
  walletId                 String               @unique
  /// Identificador de la cuenta destino en Paycomet (Split Id) tras el KYB.
  paycometSplitId          String?              @unique
  kybStatus                KybStatus            @default(PENDING)
  kybReviewedAt            DateTime?
  kybReviewedById          String?
  health                   HealthStatus         @default(OK)
  completedThisYear        Int                  @default(0)
  completedHistorical      Int                  @default(0)
  activeSponsorsCount      Int                  @default(0)
  historicalSponsorsCount  Int                  @default(0)
  medalRank                Int                  @default(0) // 0 = sin medalla; 1 Bronce, 2 Plata, 3 Oro
  /// Régimen Ley 49/2002 declarado por la entidad. Solo emite certificados fiscales si además ley49VerifiedAt != null.
  ley49                    Boolean              @default(false)
  ley49VerifiedAt          DateTime?
  customRules              Boolean              @default(false)
  exemptLimitCents         Int                  @default(100000)
  exemptRemainingCents     Int                  @default(100000)
  medalGrantAvailableCents Int                  @default(0)
  medalGrantUsedInTitle    String?
  t1Bps                    Int                  @default(500)
  t2Bps                    Int                  @default(400)
  t3Bps                    Int                  @default(300)
  sponsorFeeBps            Int                  @default(1500)
  fullIntegrityCheckCents  Int                  @default(180)
  ticketFeeFixedCents      Int                  @default(45)
  ticketFeeBps             Int                  @default(200)
  maintActive              Boolean              @default(false)
  maintPerInitCents        Int                  @default(4900)
  maintAnnualCapCents      Int                  @default(14700)
  maintPaidCents           Int                  @default(0)
  /// Curso al que pertenecen los cupos anuales de arriba (p. ej. "2026-2027"). La renovación anual de cupos lo cambia;
  /// una campaña reservada en un curso anterior ya no devuelve cupo al curso nuevo.
  quotaPeriod              String?
  donationPresetsCents     Int[]                @default([1000, 2500, 5000])
  defaultDonationIdx       Int                  @default(1)
  sponsorTiersCents        Int[]                @default([10000, 25000, 50000])
  sponsorRenewalRule       SponsorRenewalRule   @default(SOONEST)
  participationGroupsJson  Json?
  minVotes                 Int                  @default(30)
  maxIdeaDays              Int                  @default(45)
  brandPrimary             String               @default("#FF5A43")
  brandSecondary           String               @default("#FFB800")
  logoFileId               String?
  bannerFileId             String?
  /// Idioma en el que el centro redacta sus contenidos (la interfaz se traduce aparte).
  contentLocale            Locale               @default(es)
  /// La portada pública puede indexarse en buscadores (decisión del centro en el onboarding).
  publicIndexing           Boolean              @default(true)
  archivedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  logoFile              FileAsset?             @relation("OrgLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  bannerFile            FileAsset?             @relation("OrgBanner", fields: [bannerFileId], references: [id], onDelete: SetNull)
  files                 FileAsset[]            @relation("OrgFiles")
  members               OrganizationMember[]
  categories            OrganizationCategory[]
  initiatives           Initiative[]
  ideas                 Idea[]
  sponsors              Sponsor[]
  contributions         Contribution[]
  ledgerJournals        LedgerJournal[]
  walletTransactions    WalletTransaction[]
  walletSubscriptions   WalletSubscription[]
  payouts               EscrowPayout[]
  doubleCheckSignatures DoubleCheckSignature[]
  doubleCheckChallenges DoubleCheckChallenge[]
  invoices              Invoice[]
  supportTickets        SupportTicket[]
  escrowLedgerEntries   EscrowLedgerEntry[]
  opsAlerts             OpsAlert[]
}

model OrganizationMember {
  id             Int          @id @default(autoincrement())
  userId         String
  organizationId String
  role           MemberRole
  /// Etiqueta visible del cargo (p. ej. "Presidencia del AMPA", "Tesorería del club").
  roleLabel      String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId, role])
  @@index([organizationId, role])
}

model OrganizationCategory {
  id             Int              @id @default(autoincrement())
  organizationId String
  name           String
  icon           String           @default("🌟")
  rule           CategoryRuleType @default(BRACKETS)
  isCustom       Boolean          @default(true)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
}

// -----------------------------------------------------------------------------
// Iniciativas, taquilla y retos
// -----------------------------------------------------------------------------

model Initiative {
  id                         Int              @id @default(autoincrement())
  walletEscrowId             String           @unique
  paycometEscrowOrderId      String?
  format                     InitiativeFormat @default(BUDGET)
  organizationId             String
  academicYear               String
  title                      String
  category                   String
  stage                      String
  status                     InitiativeStatus @default(BUDGETING)
  stepIndex                  Int              @default(3)
  closesAt                   DateTime
  /// Fecha del primer cobro: desde aquí corre la ventana de 90 días de Paycomet para repartir fondos.
  firstPayinAt               DateTime?
  quarter                    String
  raisedCents                Int              @default(0)
  goalCents                  Int
  totalContributions         Int              @default(0)
  costMatCents               Int              @default(0)
  costInstCents              Int              @default(0)
  contingencyBps             Int              @default(1000)
  showPublicBreakdown        Boolean          @default(true)
  defaultExemptAppliedCents  Int              @default(0)
  medalExemptAppliedCents    Int              @default(0)
  /// Reserva de cupos de la entidad (exento anual, beca de medalla y tope de mantenimiento). Se reserva al pasar a
  /// FUNDRAISING y se devuelve si la campaña se cancela o se reembolsa. Las dos marcas hacen ambas operaciones idempotentes.
  quotaReservedAt            DateTime?
  quotaReleasedAt            DateTime?
  /// Instantánea de lo que se descontó realmente al reservar, y del curso de esos cupos: se devuelve exactamente esto,
  /// aunque el presupuesto cambie después, y solo si los cupos de la entidad siguen siendo del mismo curso.
  quotaReservedExemptCents   Int              @default(0)
  quotaReservedMedalCents    Int              @default(0)
  quotaReservedMaintCents    Int              @default(0)
  quotaReservedPeriod        String?
  medalRankApplied           Int              @default(0)
  bracketRateAppliedBps      Int              @default(0)
  bracketFeeCents            Int              @default(0)
  maintFeeCents              Int              @default(0)
  gatewayFeeCents            Int              @default(0)
  absorbsGatewayCostByKorum  Boolean          @default(false)
  matchingPoolTotalCents     Int              @default(0)
  matchingPoolRemainingCents Int              @default(0)
  matchingSponsorName        String?
  ticketSubtype              TicketSubtype?
  ticketPriceCents           Int?
  ticketMax                  Int?
  /// Solo lo pagado. Hasta liquidar, la suma de los pases no anulados cuadra con este contador; tras liquidar, un contracargo anula el pase sin recalcular el aforo.
  ticketsSold                Int              @default(0)
  /// Plazas retenidas por pagos en curso. La base de datos impide que ticketsSold + ticketsHeld supere ticketMax.
  ticketsHeld                Int              @default(0)
  ticketFeeMode              TicketFeeMode?
  /// Solo rifas: premios a sortear. Se fija antes de vender y no cambia después (trigger): nunca se sortean más.
  rafflePrizeCount           Int?
  ticketVenue                String?
  /// PIN de portería por EVENTO (hash Argon2/scrypt), con caducidad. Nunca en claro.
  gatePinHash                String?
  gatePinExpiresAt           DateTime?
  plaqueEnabled              Boolean          @default(true)
  rewardEnabled              Boolean          @default(true)
  targetFamiliesPerCourse    Int              @default(35)
  rewardText                 String?
  description                String
  thanksMessage              String?
  /// Traducciones opcionales del contenido: { "ca": { "title": "...", "description": "..." }, "en": {...} }.
  translationsJson           Json?
  coverFileId                String?
  beforeFileId               String?
  afterFileId                String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  coverFile           FileAsset?                 @relation("InitiativeCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  beforeFile          FileAsset?                 @relation("InitiativeBefore", fields: [beforeFileId], references: [id], onDelete: SetNull)
  afterFile           FileAsset?                 @relation("InitiativeAfter", fields: [afterFileId], references: [id], onDelete: SetNull)
  courses             InitiativeCourseProgress[]
  sponsors            Sponsor[]
  contributions       Contribution[]
  ticketPasses        TicketPass[]
  raffleNumbers       RaffleNumber[]
  raffleDraws         RaffleDraw[]
  gateSessions        GateSession[]
  ledgerJournals      LedgerJournal[]
  payout              EscrowPayout?
  resizePoll          ResizePoll?
  escrowLedgerEntries EscrowLedgerEntry[]

  @@index([organizationId, status])
  @@index([status, closesAt])
}

model InitiativeCourseProgress {
  id            Int        @id @default(autoincrement())
  initiativeId  Int
  groupName     String
  familiesCount Int        @default(0)
  initiative    Initiative @relation(fields: [initiativeId], references: [id], onDelete: Restrict)

  @@unique([initiativeId, groupName])
}

// -----------------------------------------------------------------------------
// Comercios amigos
// -----------------------------------------------------------------------------

model Sponsor {
  id                   Int                  @id @default(autoincrement())
  organizationId       String
  initiativeId         Int?
  name                 String
  /// CIF o NIF del comercio, cifrado con contexto propio de su entidad (un autónomo factura con su DNI). Ver src/core/security/crypto.ts.
  cifEnc               String?
  cifKeyVersion        Int?
  contactPerson        String
  phone                String
  email                String
  logoFileId           String?
  sector               String
  categoryLevel        SponsorCategoryLevel @default(PLATA)
  tierRank             Int                  @default(2)
  tierLabel            String
  amountCents          Int
  feeGeneratedCents    Int
  isMatchingPool       Boolean              @default(false)
  promo                String
  code                 String
  autoRenew            Boolean              @default(true)
  paymentMethodTokenId Int?
  /// Fecha del cobro del patrocinio: limita el tiempo máximo en CREDIT_POOL (ventana de 90 días).
  paidAt               DateTime?
  status               SponsorStatus        @default(PENDING)
  expiresAt            DateTime
  createdAt            DateTime             @default(now())

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiative          Initiative?         @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  logoFile            FileAsset?          @relation("SponsorLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  paymentMethodToken  PaymentMethodToken? @relation(fields: [paymentMethodTokenId], references: [id], onDelete: SetNull)
  invoices            Invoice[]
  escrowLedgerEntries EscrowLedgerEntry[]

  @@index([organizationId, status])
}

// -----------------------------------------------------------------------------
// Buzón de ideas, quórum y doble firma
// -----------------------------------------------------------------------------

model Idea {
  id                    Int                    @id @default(autoincrement())
  organizationId        String
  alias                 String
  authorCanonicalEmail  String
  title                 String
  category              String
  description           String
  phase                 IdeaPhase              @default(PHASE0_MOD)
  votes                 Int                    @default(1)
  verifiedVotes         Int                    @default(1)
  suspiciousVotes       Int                    @default(0)
  expiresAt             DateTime
  createdAt             DateTime               @default(now())
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  signatures            IdeaSignatureAudit[]
  doubleCheckChallenges DoubleCheckChallenge[]
  messages              IdeaMessage[]
  doubleCheckSignatures DoubleCheckSignature[]

  @@index([organizationId, phase])
}

/// Dispositivo identificado por una cookie propia HttpOnly firmada (necesaria para la seguridad de la votación).
/// La huella de navegador solo se guarda si hay consentimiento (ConsentPurpose.DEVICE_FINGERPRINT) y siempre como HMAC.
model Device {
  id              String               @id @default(cuid())
  cookieIdHash    String               @unique
  fingerprintHmac String?
  firstSeenAt     DateTime             @default(now())
  lastSeenAt      DateTime             @default(now())
  accounts        DeviceAccount[]
  signatures      IdeaSignatureAudit[]
  consentRecords  ConsentRecord[]
}

model DeviceAccount {
  id             Int      @id @default(autoincrement())
  deviceId       String
  userId         String
  canonicalEmail String
  /// Orden de aparición de la cuenta en el dispositivo (1ª y 2ª = familia; 3ª+ = sospechosa).
  accountOrder   Int
  firstSeenAt    DateTime @default(now())
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, userId])
}

model IdeaSignatureAudit {
  id             Int             @id @default(autoincrement())
  ideaId         Int
  userId         String?
  canonicalEmail String
  deviceId       String?
  ipSubnetHash   String?
  accountOrder   Int             @default(1)
  status         SignatureStatus @default(VERIFIED)
  reason         String
  createdAt      DateTime        @default(now())
  idea           Idea            @relation(fields: [ideaId], references: [id], onDelete: Restrict)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  device         Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([ideaId, canonicalEmail])
  @@unique([ideaId, userId])
}

model IdeaMessage {
  id          Int               @id @default(autoincrement())
  ideaId      Int
  senderRole  IdeaMessageSender
  senderLabel String
  body        String
  createdAt   DateTime          @default(now())
  idea        Idea              @relation(fields: [ideaId], references: [id], onDelete: Restrict)
}

model DoubleCheckSignature {
  id             Int                   @id @default(autoincrement())
  organizationId String
  targetType     DoubleCheckTargetType
  ideaId         Int?
  payoutId       Int?
  signerUserId   String
  signerRole     MemberRole
  /// Lo que se firmó, para poder volver a verificar la huella aunque el importe cambie después.
  targetDigest   String                @default("")
  /// Fila del cargo con el que se firmó. Sin clave foránea: debe sobrevivir a la baja para poder verificar la huella.
  membershipId   Int                   @default(0)
  /// HMAC de la firma y de lo firmado (importe, cuenta destino o texto de la idea): si algo cambia, deja de valer. Ver signature-hash.ts.
  signatureHash  String
  otpVerifiedAt  DateTime?
  signerIpHash   String?
  signedAt       DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  idea           Idea?                 @relation(fields: [ideaId], references: [id], onDelete: Restrict)
  payout         EscrowPayout?         @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  signer         User                  @relation(fields: [signerUserId], references: [id], onDelete: Restrict)

  @@unique([targetType, ideaId, signerRole])
  @@unique([targetType, payoutId, signerRole])
}

/// Enlace de un solo uso + OTP para firmar. Solo se guardan sus HMAC; `targetDigest` fija lo que se pidió firmar.
model DoubleCheckChallenge {
  id             String                @id @default(cuid())
  organizationId String
  targetType     DoubleCheckTargetType
  ideaId         Int?
  payoutId       Int?
  signerUserId   String
  signerRole     MemberRole
  tokenHash      String                @unique
  otpHmac        String
  targetDigest   String
  attempts       Int                   @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  idea           Idea?                 @relation(fields: [ideaId], references: [id], onDelete: Restrict)
  payout         EscrowPayout?         @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  signer         User                  @relation(fields: [signerUserId], references: [id], onDelete: Restrict)

  @@index([targetType, ideaId, signerUserId])
  @@index([targetType, payoutId, signerUserId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Cobros, pases QR y portería
// -----------------------------------------------------------------------------

model Contribution {
  id                         Int                 @id @default(autoincrement())
  organizationId             String
  initiativeId               Int
  userId                     String?
  guestEmail                 String?
  canonicalEmail             String?
  locale                     Locale              @default(es)
  fiscalYear                 Int
  type                       ContributionType    @default(DONATION)
  groupName                  String?
  /// Solo TICKET: entradas o papeletas de esta compra.
  ticketQuantity             Int?
  /// Solo TICKET: con valor mientras esta compra retiene plazas en `Initiative.ticketsHeld`.
  ticketHoldUntil            DateTime?
  amountCents                Int
  /// Aportación voluntaria de garantía KORUM (0 si el check no se marcó; va DESMARCADO por defecto).
  guaranteeContributionCents Int                 @default(0)
  matchedBonusCents          Int                 @default(0)
  totalChargedCents          Int
  isTaxDeductible            Boolean             @default(false)
  /// Datos del donante para el Modelo 182 (solo DONATION en entidades ley49 verificadas).
  donorFullName              String?
  donorTaxIdEnc              String?
  donorTaxIdHmac             String?
  donorTaxIdKeyVersion       Int?
  donorProvinceCode          String?
  /// Solo para SELF_BOOST: si el Auto-Impulso se muestra en público (lo decide el Super-Admin).
  publiclyDisclosed          Boolean             @default(true)
  paymentMethod              PaymentMethod
  paycometOrder              String?             @unique
  paycometAuthCode           String?
  status                     ContributionStatus  @default(PENDING)
  refundedCents              Int                 @default(0)
  refundedAt                 DateTime?
  /// Devolución pedida a Paycomet sin confirmar: mientras esté puesta no se vuelve a pedir, para no devolver dos veces.
  refundSendingAt            DateTime?
  createdAt                  DateTime            @default(now())
  organization               Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiative                 Initiative          @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  user                       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticketPass                 TicketPass?
  walletTransactions         WalletTransaction[]
  ledgerJournals             LedgerJournal[]
  payoutSplits               EscrowPayoutSplit[]

  @@index([initiativeId, status])
  @@index([initiativeId, ticketHoldUntil])
  @@index([status, refundSendingAt])
  @@index([organizationId, fiscalYear, type])
  @@index([donorTaxIdHmac, fiscalYear])
  @@index([canonicalEmail])
}

model TicketPass {
  id              Int             @id @default(autoincrement())
  uuid            String          @unique @default(uuid())
  contributionId  Int             @unique
  initiativeId    Int
  serialCode      String          @unique
  subtype         TicketSubtype   @default(EVENT)
  holderEmail     String
  quantity        Int             @default(1)
  checkedInCount  Int             @default(0)
  raffleNumbers   Int[]           @default([])
  qrHmacSignature String
  lastCheckedInAt DateTime?
  isWinner        Boolean         @default(false)
  /// Reembolso o contracargo: el pase deja de valer en la puerta y en el sorteo.
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  contribution    Contribution    @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  initiative      Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  checkIns        TicketCheckIn[]
  numbers         RaffleNumber[]
}

/// Número de rifa ocupado. Al anular el pase se borra y el número vuelve a estar libre, así la numeración no pasa de `ticketMax`.
model RaffleNumber {
  initiativeId Int
  number       Int
  ticketPassId Int
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  ticketPass   TicketPass @relation(fields: [ticketPassId], references: [id], onDelete: Restrict)

  @@id([initiativeId, number])
  @@index([ticketPassId])
}

/// Acta de un sorteo. Inmutable (trigger y extensión del cliente), y nunca más premios que `Initiative.rafflePrizeCount`: repetir hasta que salga quien se quiere no es posible.
model RaffleDraw {
  id                 Int        @id @default(autoincrement())
  initiativeId       Int
  round              Int
  /// La misma clave devuelve la misma acta: un doble toque no saca otro ganador.
  idempotencyKey     String
  /// Con valor si es una ronda extra hecha por los firmantes (premio sin reclamar, ganador reembolsado).
  extraRoundReason   String?
  /// Lista de papeletas participantes: solo número y serie, sin datos personales.
  participantsJson   Json
  participantsSha256 String
  winningNumbers     Int[]
  actSha256          String
  drawnByType        String
  drawnById          String
  drawnAt            DateTime
  initiative         Initiative @relation(fields: [initiativeId], references: [id], onDelete: Restrict)

  @@unique([initiativeId, round])
  @@unique([initiativeId, idempotencyKey])
}

/// Sesión de portería abierta con el PIN del evento. El token solo se guarda como hash.
model GateSession {
  id           String          @id @default(cuid())
  initiativeId Int
  tokenHash    String          @unique
  deviceLabel  String?
  createdAt    DateTime        @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  initiative   Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  checkIns     TicketCheckIn[]
}

model TicketCheckIn {
  id            Int          @id @default(autoincrement())
  ticketPassId  Int
  gateSessionId String?
  quantity      Int
  accepted      Boolean
  reason        String? // "FIRMA_INVALIDA", "PASE_AGOTADO"...
  createdAt     DateTime     @default(now())
  ticketPass    TicketPass   @relation(fields: [ticketPassId], references: [id], onDelete: Restrict)
  gateSession   GateSession? @relation(fields: [gateSessionId], references: [id], onDelete: SetNull)

  @@index([ticketPassId, createdAt])
}

// -----------------------------------------------------------------------------
// Libro mayor de doble partida (inmutable)
// -----------------------------------------------------------------------------

/// Asiento contable. Invariante: Σ entries(DEBIT).amountCents == Σ entries(CREDIT).amountCents, comprobado al confirmar la
/// transacción por un trigger diferido. Inmutable: triggers que impiden UPDATE/DELETE/TRUNCATE en esta tabla, en
/// EscrowLedgerEntry y en AuditLog (migración prisma/migrations/*_ledger_immutability).
model LedgerJournal {
  id                Int               @id @default(autoincrement())
  idempotencyKey    String            @unique
  kind              LedgerJournalKind
  organizationId    String?
  initiativeId      Int?
  contributionId    Int?
  walletTxId        Int?
  payoutId          Int?
  paycometReference String?
  description       String
  occurredAt        DateTime          @default(now())
  createdById       String? // userId o "system"
  reversesJournalId Int?              @unique
  createdAt         DateTime          @default(now())
  /// Transacción de PostgreSQL que registró el asiento (la fija un trigger). Solo esa transacción puede añadirle apuntes:
  /// así nadie puede ampliar un asiento ya confirmado. No se expone en el cliente.
  postedTxId        BigInt            @default(dbgenerated("txid_current()")) @ignore

  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiative        Initiative?         @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  contribution      Contribution?       @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction?  @relation(fields: [walletTxId], references: [id], onDelete: Restrict)
  payout            EscrowPayout?       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  reversesJournal   LedgerJournal?      @relation("JournalReversal", fields: [reversesJournalId], references: [id], onDelete: Restrict)
  reversedBy        LedgerJournal?      @relation("JournalReversal")
  entries           EscrowLedgerEntry[]

  @@index([organizationId, occurredAt])
  @@index([initiativeId])
}

/// Apunte de un asiento. amountCents siempre > 0 (CHECK en la migración SQL); el signo lo da direction.
/// organizationId / initiativeId / userId / sponsorId son dimensiones de subcuenta para calcular saldos.
model EscrowLedgerEntry {
  id             Int             @id @default(autoincrement())
  journalId      Int
  account        LedgerAccount
  direction      LedgerDirection
  amountCents    Int
  currency       String          @default("EUR")
  organizationId String?
  initiativeId   Int?
  userId         String?
  sponsorId      Int?
  createdAt      DateTime        @default(now())
  journal        LedgerJournal   @relation(fields: [journalId], references: [id], onDelete: Restrict)
  /// Claves foráneas de las dimensiones: un apunte nunca puede apuntar a una entidad, iniciativa, familia o comercio inexistente.
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiative     Initiative?     @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  sponsor        Sponsor?        @relation(fields: [sponsorId], references: [id], onDelete: Restrict)

  /// Los triggers de cuadre (por asiento y por apunte), `findByKey` y `reverseJournal` filtran por `journalId`.
  @@index([journalId])
  @@index([account, organizationId])
  @@index([account, initiativeId])
  @@index([account, userId])
}

// -----------------------------------------------------------------------------
// Mi Hucha y medios de pago tokenizados
// -----------------------------------------------------------------------------

/// Token de tarjeta de Paycomet (JET-ID: idUser + tokenUser), siempre cifrado. Nunca se guarda el PAN.
model PaymentMethodToken {
  id                 Int                  @id @default(autoincrement())
  userId             String?
  provider           String               @default("paycomet")
  idUserEnc          String
  tokenUserEnc       String
  keyVersion         Int
  brand              String?
  last4              String?
  expiresMonth       Int?
  expiresYear        Int?
  createdAt          DateTime             @default(now())
  revokedAt          DateTime?
  /// Borrada también en Paycomet (supresión de la cuenta). Hasta entonces se conserva el token cifrado para poder pedir el borrado.
  providerDeletedAt  DateTime?
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  sponsors           Sponsor[]
  subscriptions      WalletSubscription[]
  walletTransactions WalletTransaction[]
}

/// Movimiento de Mi Hucha. organizationId solo se rellena al gastar el saldo en una iniciativa (CONTRIBUTION_DEBIT):
/// la Hucha es una por usuario, no una por centro.
model WalletTransaction {
  id                       Int                 @id @default(autoincrement())
  userId                   String
  organizationId           String?
  contributionId           Int?
  paymentMethodTokenId     Int?
  txType                   WalletTxType
  amountCents              Int
  feeCents                 Int                 @default(0)
  remainingRefundableCents Int                 @default(0)
  paycometOrder            String?             @unique
  refundedFromOrder        String?
  status                   WalletTxStatus      @default(PENDING)
  createdAt                DateTime            @default(now())
  user                     User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization             Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contribution             Contribution?       @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  paymentMethodToken       PaymentMethodToken? @relation(fields: [paymentMethodTokenId], references: [id], onDelete: SetNull)
  ledgerJournals           LedgerJournal[]

  @@index([userId, createdAt])
}

/// Recarga mensual programada (modo REGULATED_WALLET) o aportación mensual comprometida a una entidad (modo PLEDGE).
model WalletSubscription {
  id                   Int                @id @default(autoincrement())
  userId               String
  organizationId       String?
  paymentMethodTokenId Int
  monthlyAmountCents   Int
  feePerMonthCents     Int                @default(25)
  totalMonths          Int                @default(9)
  executedMonths       Int                @default(0)
  active               Boolean            @default(true)
  nextChargeAt         DateTime
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization         Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paymentMethodToken   PaymentMethodToken @relation(fields: [paymentMethodTokenId], references: [id], onDelete: Restrict)

  @@index([active, nextChargeAt])
}

// -----------------------------------------------------------------------------
// Liquidaciones, redimensionamiento y facturación
// -----------------------------------------------------------------------------

model EscrowPayout {
  id                    Int                    @id @default(autoincrement())
  organizationId        String
  initiativeId          Int                    @unique
  destinationType       PayoutDestination      @default(PROVIDER)
  beneficiaryName       String
  beneficiaryIban       String
  providerCif           String?
  providerInvoiceFileId String?
  netPaidCents          Int
  korumFeeSettledCents  Int
  /// Cuenta destino fijada al aprobar: las firmas valen para esa cuenta, aunque la entidad cambie la suya después.
  destinationSplitId    String?
  paycometTransferId    String?
  status                PayoutStatus           @default(PENDING_DOUBLE_CHECK)
  executedAt            DateTime?
  createdAt             DateTime               @default(now())
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiative            Initiative             @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  providerInvoiceFile   FileAsset?             @relation("PayoutProviderInvoice", fields: [providerInvoiceFileId], references: [id], onDelete: Restrict)
  signatures            DoubleCheckSignature[]
  doubleCheckChallenges DoubleCheckChallenge[]
  invoices              Invoice[]
  ledgerJournals        LedgerJournal[]
  splits                EscrowPayoutSplit[]
}

/// Un reparto de una liquidación: Paycomet reparte cobro a cobro, y cada cobro tiene su ventana de 90 días.
model EscrowPayoutSplit {
  id             Int               @id @default(autoincrement())
  payoutId       Int
  contributionId Int
  amountCents    Int
  status         PayoutSplitStatus @default(PENDING)
  splitAuthCode  String?
  errorMessage   String?
  attempts       Int               @default(0)
  sentAt         DateTime?
  executedAt     DateTime?
  createdAt      DateTime          @default(now())
  payout         EscrowPayout      @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  contribution   Contribution      @relation(fields: [contributionId], references: [id], onDelete: Restrict)

  @@unique([payoutId, contributionId])
  @@index([payoutId, status])
}

model ResizePoll {
  id           Int              @id @default(autoincrement())
  initiativeId Int              @unique
  optionsJson  Json
  closesAt     DateTime
  status       ResizePollStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  initiative   Initiative       @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  votes        ResizeVote[]
}

model ResizeVote {
  id             Int        @id @default(autoincrement())
  pollId         Int
  canonicalEmail String
  optionIndex    Int
  createdAt      DateTime   @default(now())
  poll           ResizePoll @relation(fields: [pollId], references: [id], onDelete: Restrict)

  @@unique([pollId, canonicalEmail])
}

/// Factura emitida por KORUM (a comercios o centros). Se registra en Veri*factu a través del proveedor de facturación.
model Invoice {
  id                       Int                    @id @default(autoincrement())
  invoiceNumber            String                 @unique
  /// Una misma operación (un patrocinio, una liquidación) nunca genera dos facturas aunque se reintente.
  idempotencyKey           String?                @unique
  /// NIF con el que se calculó la huella: la cadena se comprueba siempre con el mismo, aunque cambie el ajuste de la consola.
  issuerTaxId              String?
  series                   String                 @default("K")
  organizationId           String
  sponsorId                Int?
  payoutId                 Int?
  recipientName            String
  /// NIF del destinatario, cifrado con su número de factura como contexto. No forma parte de la huella Veri*factu (solo el del emisor).
  recipientTaxIdEnc        String?
  recipientTaxIdKeyVersion Int?
  concept                  String
  baseAmountCents          Int
  taxRateBps               Int                    @default(2100)
  taxAmountCents           Int                    @default(0)
  totalAmountCents         Int
  prevVerifactuHash        String?
  verifactuHash            String                 @unique
  verifactuQrUrl           String
  verifactuStatus          InvoiceVerifactuStatus @default(PENDING)
  providerReference        String?
  pdfFileId                String?
  issuedAt                 DateTime               @default(now())
  /// Momento en que se reservó el envío al proveedor (`PENDING → SENT`). Si lleva horas sin resolverse, hay un envío de resultado desconocido.
  sentAt                   DateTime?
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sponsor                  Sponsor?               @relation(fields: [sponsorId], references: [id], onDelete: Restrict)
  payout                   EscrowPayout?          @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  pdfFile                  FileAsset?             @relation("InvoicePdf", fields: [pdfFileId], references: [id], onDelete: Restrict)
}

model SupportTicket {
  id             Int                 @id @default(autoincrement())
  ticketCode     String              @unique
  organizationId String?
  originLabel    String
  senderEmail    String?
  target         SupportTarget       @default(SUPERADMIN)
  subject        String
  message        String
  status         SupportTicketStatus @default(OPEN)
  replyMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// Ficheros (Supabase Storage, región UE)
// -----------------------------------------------------------------------------

model FileAsset {
  id             String         @id @default(cuid())
  bucket         String
  objectKey      String         @unique
  visibility     FileVisibility
  purpose        FilePurpose
  mimeType       String
  sizeBytes      Int
  sha256         String
  organizationId String?
  uploadedById   String?
  /// Fecha hasta la que hay que conservarlo por ley (facturas, KYB). El borrado lo hace DATA_RETENTION_PURGE.
  retainUntil    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  organization      Organization?  @relation("OrgFiles", fields: [organizationId], references: [id], onDelete: Restrict)
  orgLogos          Organization[] @relation("OrgLogo")
  orgBanners        Organization[] @relation("OrgBanner")
  initiativeCovers  Initiative[]   @relation("InitiativeCover")
  initiativeBefores Initiative[]   @relation("InitiativeBefore")
  initiativeAfters  Initiative[]   @relation("InitiativeAfter")
  sponsorLogos      Sponsor[]      @relation("SponsorLogo")
  payoutInvoices    EscrowPayout[] @relation("PayoutProviderInvoice")
  korumInvoicePdfs  Invoice[]      @relation("InvoicePdf")

  @@index([organizationId, purpose])
}

// -----------------------------------------------------------------------------
// Operación: auditoría, webhooks, notificaciones y tareas programadas
// -----------------------------------------------------------------------------

/// Registro de auditoría append-only (trigger en la migración SQL). Nunca guarda secretos ni PII en claro.
model AuditLog {
  id             Int            @id @default(autoincrement())
  occurredAt     DateTime       @default(now())
  actorType      AuditActorType
  actorUserId    String?
  organizationId String?
  action         String // p. ej. "payout.signed", "settings.secret.updated", "tenant.access_denied"
  targetType     String
  targetId       String
  ipHash         String?
  userAgent      String?
  metadataJson   Json?

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
}

/// Webhooks recibidos. La unicidad (provider, externalEventId) hace la recepción idempotente.
model WebhookEvent {
  id              Int           @id @default(autoincrement())
  provider        String
  externalEventId String
  signatureValid  Boolean
  payloadJson     Json
  status          WebhookStatus @default(RECEIVED)
  attempts        Int           @default(0)
  errorMessage    String?
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
}

/// Bandeja de salida de notificaciones (patrón outbox): se escribe en la misma transacción que el cambio de negocio.
model OutboxMessage {
  id                Int                 @id @default(autoincrement())
  idempotencyKey    String              @unique
  channel           NotificationChannel @default(EMAIL)
  templateKey       String // Catálogo en docs/EXPERIENCIA_DE_PRODUCTO.md §4
  locale            Locale              @default(es)
  toAddress         String
  userId            String?
  organizationId    String?
  payloadJson       Json
  status            OutboxStatus        @default(PENDING)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime            @default(now())

  @@index([status, nextAttemptAt])
}

/// Cola de tareas programadas procesada por los cron de /api/cron/* (idempotente y con reintentos).
model Job {
  id             Int       @id @default(autoincrement())
  idempotencyKey String    @unique
  type           JobType
  payloadJson    Json
  runAt          DateTime
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
}

/// Alerta de operación para la consola del Super-Admin. A diferencia de `AuditLog` (inmutable), tiene estado: se abre una vez por
/// `dedupeKey`, cuenta sus repeticiones y se resuelve. El detalle no lleva datos personales.
model OpsAlert {
  id             String           @id @default(cuid())
  type           OpsAlertType
  severity       OpsAlertSeverity
  status         OpsAlertStatus   @default(OPEN)
  /// Un mismo problema no abre dos alertas: la clave identifica el problema (p. ej. `JOB_FAILED:MASS_REFUND:2026-11-04`).
  dedupeKey      String           @unique
  organizationId String?
  targetType     String?
  targetId       String?
  detailJson     Json
  occurrences    Int              @default(1)
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  resolvedAt     DateTime?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, severity, lastSeenAt])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// Privacidad (RGPD)
// -----------------------------------------------------------------------------

model ConsentRecord {
  id               Int            @id @default(autoincrement())
  userId           String?
  deviceId         String?
  subjectEmailHmac String?
  purpose          ConsentPurpose
  granted          Boolean
  policyVersion    String
  source           String // "banner", "checkout", "ajustes"...
  createdAt        DateTime       @default(now())
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  device           Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, purpose])
}

model PrivacyRequest {
  id                 Int                  @id @default(autoincrement())
  userId             String?
  requesterEmailHmac String
  type               PrivacyRequestType
  status             PrivacyRequestStatus @default(RECEIVED)
  /// Plazo legal de respuesta (1 mes desde la solicitud).
  dueAt              DateTime
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime             @default(now())
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
}
