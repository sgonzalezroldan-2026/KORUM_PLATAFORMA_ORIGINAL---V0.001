/// Plan de cuentas del libro mayor. Ver ejemplos de asientos en .agents/skills/korum-escrow-payments/SKILL.md.
enum LedgerAccount {
  PSP_CLEARING // Activo: dinero cobrado que está en Paycomet
  INITIATIVE_ESCROW // Pasivo: fondos retenidos por iniciativa hasta lograr la meta
  FAMILY_WALLET // Pasivo: saldo de Mi Hucha (solo si hucha.mode = REGULATED_WALLET)
  SPONSOR_CREDIT_POOL // Pasivo: patrocinios pendientes de reasignar
  MATCHING_POOL // Pasivo: bolsa Matching 2x comprometida por un patrocinador
  ORG_PAYABLE // Pasivo: importe aprobado para liquidar a la entidad o a su proveedor
  REFUNDS_PAYABLE // Pasivo: devoluciones aprobadas pendientes de ejecutar
  TAX_PAYABLE_VAT // Pasivo: IVA repercutido en facturas de KORUM
  KORUM_REVENUE_GUARANTEE // Ingreso: aportaciones voluntarias de garantía
  KORUM_REVENUE_BRACKET // Ingreso: comisión por tramos
  KORUM_REVENUE_SPONSOR_FEE // Ingreso: fee de gestión publicitaria
  KORUM_REVENUE_TICKET_FEE // Ingreso: gastos de gestión digital
  KORUM_REVENUE_MAINTENANCE // Ingreso: cuota de mantenimiento
  KORUM_REVENUE_TOPUP_FEE // Ingreso: gestión de recargas de Mi Hucha
  GATEWAY_FEES_RECOVERED // Ingreso: coste de pasarela incluido en la meta y recuperado al liquidar
  GATEWAY_FEES_EXPENSE // Gasto: comisiones cobradas por Paycomet
  AUTO_BOOST_EXPENSE // Gasto: Auto-Impulso aportado por KORUM
  CHARGEBACK_LOSSES // Gasto: contracargos no recuperables
}

