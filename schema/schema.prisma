enum JobType {
  CAMPAIGN_EXPIRY // Vence una iniciativa: pasa a EXPIRED y avisa al centro
  MASS_REFUND // Reembolso masivo de una iniciativa (por lotes, idempotente)
  MONTHLY_TOPUP // Cargo mensual programado de Mi Hucha / aportación recurrente
  SPONSOR_RENEWAL_NOTICE // Preaviso de renovación a 30 días
  SPONSOR_RENEWAL_CHARGE // Cargo de renovación anual
  CREDIT_POOL_EXPIRY // Bolsa de patrocinio sin asignar: reembolso al comercio
  SPLIT_WINDOW_GUARD // Aviso antes de que venza la ventana de 90 días de Paycomet
  PSP_RECONCILIATION // Conciliación diaria Paycomet ↔ libro mayor
  MODEL182_REMINDER // Recordatorio de enero para exportar el Modelo 182
  DATA_RETENTION_PURGE // Borrado/anonimización por plazos de conservación
  OUTBOX_DISPATCH // Envío de notificaciones pendientes
  QUOTA_RENEWAL // Renovación anual de cupos (exento, beca de medalla y mantenimiento) de cada entidad
  TICKET_HOLD_RELEASE // Libera las plazas reservadas cuyo pago no llegó
  INVOICE_SUBMIT // Envía al proveedor Veri*factu las facturas pendientes
  OPS_HOUSEKEEPING // Purga de límites de intentos, notificaciones rechazadas y desafíos de firma caducados
}

enum OpsAlertType {
  JOB_FAILED
  REFUND_REJECTED
  REFUND_STUCK
  SPLIT_WINDOW_EXPIRING
  RECONCILIATION_MISMATCH
  CHARGEBACK_UNCONFIRMED
  INVOICE_STUCK
  SPONSOR_RENEWAL_DUE
  CREDIT_POOL_EXPIRED
  MONTHLY_TOPUP_DUE
  /// Una iniciativa devuelta (`REFUNDED`) conserva dinero en su hucha: patrocinio o Auto-Impulso, que no se devuelven con `MASS_REFUND`.
  ESCROW_LEFTOVER
  /// Al suprimir una cuenta, Paycomet no confirmó el borrado de una tarjeta: la purga semanal lo reintenta.
  CARD_DELETE_FAILED
  /// Una solicitud de derechos RGPD supera su plazo legal de respuesta (1 mes).
  PRIVACY_REQUEST_OVERDUE
  /// Hay datos cifrados con una versión de clave que ya no está disponible: no se pueden volver a cifrar con la actual.
  ENCRYPTION_KEY_MISSING
  /// La supresión automática de una cuenta inactiva falló por un error inesperado: se reintenta cada semana.
  PRIVACY_ERASURE_FAILED
  /// La bandeja de salida no puede enviar emails: proveedor sin configurar, plantilla desconocida o mensajes que agotan sus reintentos.
  EMAIL_DELIVERY_FAILED
}

