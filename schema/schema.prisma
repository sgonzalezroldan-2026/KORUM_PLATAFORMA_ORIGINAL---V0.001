// =============================================================================
// KORUM v8.5 · Esquema de datos (PostgreSQL + Prisma ORM 7)
// -----------------------------------------------------------------------------
// Reglas que este esquema garantiza (ver .agents/rules/02-invariantes-financieros.md):
//  1. Dinero SIEMPRE en céntimos enteros (Int) y porcentajes en puntos básicos (Bps). Prohibido Float.
//  2. Libro mayor de DOBLE PARTIDA: cada LedgerJournal (asiento) agrupa apuntes EscrowLedgerEntry
//     cuya suma de DEBIT es igual a la suma de CREDIT. Los asientos nunca se editan ni se borran:
//     se corrigen con un contra-asiento (reversesJournalId).
//  3. Nada contable, fiscal o de auditoría se borra en cascada. Las organizaciones se archivan
//     (archivedAt) y los usuarios se anonimizan (gdprAnonymizedAt); por eso las relaciones con
//     Organization usan onDelete: Restrict.
//  4. Secretos y tokens de pago se guardan cifrados (AES-256-GCM, campos *Enc + keyVersion).
//     Los identificadores personales que hay que buscar (NIF, huellas) se guardan como HMAC.
//  5. Estados con valores cerrados = enum. Las etiquetas visibles (es/ca/en) viven en los
//     catálogos de traducción, nunca en la base de datos (ver docs/GLOSARIO.md).
//
// Prisma 7: la URL de conexión se define en prisma.config.ts (Sprint 1.1), no aquí.
// Los modelos de autenticación (Session, Account, Verification, TwoFactor, Passkey) siguen el
// formato de Better Auth; validarlos con su CLI al implementar la autenticación (Sprint 3.2).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

